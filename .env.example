# Development only. Use a dedicated managed PostgreSQL database in production.
DATABASE_URL=postgresql://campus:campus_local_only@localhost:5432/campus
APP_ORIGIN=http://localhost:8888
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
# Optional: HTTPS endpoint owned by your team; receives redacted security alerts.
ALERT_WEBHOOK_URL=
