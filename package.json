{
  "name": "campus-helpdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run check",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
